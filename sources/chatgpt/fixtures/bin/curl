#!/usr/bin/env python3
"""Offline stand-in for the explicitly granted curl program; no account or network needed."""
import json
import sys

config = sys.stdin.read()
assert "Authorization: Bearer " in config
assert "Cookie: fixture-cookie" in config
assert "https://chatgpt.com/backend-api/" in config

if "Bearer expired-session" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:401')
    raise SystemExit(0)
if "Bearer throttled-session" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:429')
    raise SystemExit(0)

if "/messages?before=" in config:
    response = {"messages": [] if "Bearer partial-session" in config else
                [{"id": "old", "author": {"role": "user"}, "content": {"parts": ["Before"]}}],
                "page_info": {"has_previous_page": False, "start_cursor": "previous"}}
elif "/conversations/web-example?" in config:
    response = {"conversation_id": "web-example", "title": "Web conversation", "create_time": 1767225600,
                "messages": [{"id": "new", "author": {"role": "assistant"}, "content": {"parts": ["After"]}}],
                "page_info": {"has_previous_page": True, "start_cursor": "previous"}}
elif "/conversations?" in config:
    archived = "is_archived=true" in config
    if "Bearer shifted-session" in config and not archived:
        offset = int(config.split("offset=", 1)[1].split("&", 1)[0])
        response = {"total": 21, "items": [{"id": "web-example"}] * 20 if not offset else [{"id": "web-example"}]}
    else:
        response = {"total": 0 if archived else 1,
                    "items": [] if archived else [{"id": "web-example", "update_time": "2026-01-01T00:00:00Z"}]}
else:
    raise SystemExit(2)

sys.stdout.write(json.dumps(response) + "\nMEMCASTLE_HTTP_STATUS:200")
