#!/usr/bin/env python3
"""Offline stand-in for the explicitly granted curl program; no account or network needed."""
import json
import sys
from urllib.parse import parse_qs, urlsplit

config = sys.stdin.read()
assert "Authorization: Bearer " in config
if "Bearer fixture-oauth" in config:
    assert "Cookie:" not in config
else:
    assert "Cookie: fixture-cookie" in config
assert "User-Agent: Mozilla/5.0" in config
assert "https://chatgpt.com/backend-api/" in config
url = urlsplit(config.split('url = "', 1)[1].split('"', 1)[0])
params = parse_qs(url.query)

if "Bearer expired-session" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:401')
    raise SystemExit(0)
if "Bearer throttled-session" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:429')
    raise SystemExit(0)

if url.path.endswith("/messages"):
    response = {"messages": [] if "Bearer partial-session" in config else
                [{"id": "old", "author": {"role": "user"}, "content": {"parts": ["Before"]}}],
                "page_info": {"has_previous_page": False, "start_cursor": "previous"}}
elif url.path == "/backend-api/gizmos/snorlax/sidebar":
    names = ["Shared", "Shared", "Empty"] if "Bearer duplicate-name-session" in config else ["Alpha", "Beta", "Empty"]
    position = {"next-projects": 1, "next-empty": 2}.get(params.get("cursor", [""])[0], 0)
    response = {"items": [{"gizmo": {"gizmo": {"id": ["g-p-alpha", "g-p-beta", "g-p-empty"][position],
                                                  "display": {"name": names[position]},
                                                  "is_archived": position == 1}},
                          "conversations": {"items": [], "cursor": "preview-is-not-history"}}],
                "cursor": ["next-projects", "next-empty", None][position]}
elif url.path.startswith("/backend-api/gizmos/g-p-") and url.path.endswith("/conversations"):
    project = url.path.split("/")[3]
    position = 2 if params.get("cursor") else 1
    chat_id = f"project-{project.removeprefix('g-p-')}-chat-{position}"
    response = {"items": [] if project == "g-p-empty" else [{"id": chat_id,
                           "gizmo_id": "g-p-beta" if "Bearer wrong-project-session" in config else project,
                           "title": "Example", "update_time": "2026-01-01T00:00:00Z"}],
                "cursor": "next-alpha" if project == "g-p-alpha" and position == 1 else None}
    if "Bearer repeated-project-cursor" in config and project == "g-p-alpha":
        response["cursor"] = "next-alpha"
elif url.path.startswith("/backend-api/conversations/"):
    conversation_id = url.path.split("/")[3]
    response = {"conversation_id": conversation_id, "title": "Web conversation", "create_time": 1767225600,
                "gizmo_id": None, "owner": None,
                "messages": [{"id": "new", "author": {"role": "assistant"}, "content": {"parts": ["After"]}}],
                "page_info": {"has_previous_page": True, "start_cursor": "previous"}}
elif url.path == "/backend-api/conversations":
    archived = "is_archived=true" in config
    if "Bearer shifted-session" in config and not archived:
        offset = int(config.split("offset=", 1)[1].split("&", 1)[0])
        response = {"total": 21, "items": [{"id": "web-example"}] * 20 if not offset else [{"id": "web-example"}]}
    else:
        response = {"total": 0 if archived else 1,
                    "items": [] if archived else [{"id": "web-example", "update_time": "2026-01-01T00:00:00Z"}]}
else:
    raise SystemExit(2)

sys.stdout.write(json.dumps(response) + "\nMEMCASTLE_HTTP_STATUS:200")
