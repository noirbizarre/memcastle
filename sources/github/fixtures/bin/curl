#!/usr/bin/env python3
"""Offline GitHub REST stand-in; the real API and real credentials are never used."""
import json
import sys
from urllib.parse import parse_qs, urlsplit

config = sys.stdin.read()
assert "https://api.github.com/" in config
assert "--" not in config  # curl flags are separate arguments, never part of the secret input
url = urlsplit(config.split('url = "', 1)[1].split('"', 1)[0])
page = int(parse_qs(url.query).get("page", ["1"])[0])
now = "2026-01-01T00:00:00Z"


def repo(name):
    return {"id": {"acme/alpha": 1, "acme/other": 2}.get(name, 3), "full_name": name,
            "name": name.split("/")[-1], "description": "Example repository", "topics": ["docs"],
            "html_url": f"https://github.com/{name}", "updated_at": now}


def issue(number, pull=False):
    value = {"id": number * 10, "number": number, "title": f"Item {number}",
             "body": f"Body {number}", "labels": [{"name": "wanted"}],
             "updated_at": f"2026-01-0{number}T00:00:00Z",
             "html_url": f"https://github.com/acme/alpha/{'pull' if pull else 'issues'}/{number}"}
    if pull:
        value["pull_request"] = {"url": "https://api.github.com/"}
    return value


path = url.path
if path == "/orgs/acme/repos":
    response = [repo("acme/alpha"), repo("acme/other")]
elif path == "/repos/acme/alpha":
    response = repo("acme/alpha")
elif path == "/repos/acme/other":
    response = repo("acme/other")
elif path == "/repos/acme/alpha/issues":
    response = [issue(1), issue(2, True)]
elif path == "/repos/acme/other/issues":
    response = [issue(1)]
elif path == "/repos/acme/alpha/issues/1":
    response = issue(1)
elif path == "/repos/acme/alpha/pulls/2":
    response = issue(2, True)
elif path == "/repos/acme/alpha/issues/comments":
    response = [{"id": 31, "body": "A comment", "issue_url": "https://api.github.com/repos/acme/alpha/issues/1",
                 "html_url": "https://github.com/acme/alpha/issues/1#issuecomment-31", "updated_at": now}]
elif path == "/repos/acme/alpha/issues/comments/31":
    response = {"id": 31, "body": "A comment", "html_url": "https://github.com/acme/alpha/issues/1#issuecomment-31"}
elif path == "/repos/acme/alpha/pulls/comments":
    response = [{"id": 41, "body": "Inline review", "pull_request_url": "https://api.github.com/repos/acme/alpha/pulls/2",
                 "html_url": "https://github.com/acme/alpha/pull/2#discussion_r41", "updated_at": now}]
elif path == "/repos/acme/alpha/pulls/comments/41":
    response = {"id": 41, "body": "Inline review", "html_url": "https://github.com/acme/alpha/pull/2#discussion_r41"}
elif path == "/repos/acme/alpha/pulls/2/reviews":
    response = [{"id": 51, "body": "Approved", "submitted_at": now,
                 "html_url": "https://github.com/acme/alpha/pull/2#pullrequestreview-51"}]
elif path == "/repos/acme/alpha/pulls/2/reviews/51":
    response = {"id": 51, "body": "Approved", "html_url": "https://github.com/acme/alpha/pull/2#pullrequestreview-51"}
else:
    raise SystemExit(f"unexpected GitHub fixture request: {path}")

if page > 1 and isinstance(response, list):
    response = []
if "Bearer rejected-token" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:401')
elif "Bearer throttled-token" in config:
    sys.stdout.write('{}\nMEMCASTLE_HTTP_STATUS:429')
else:
    sys.stdout.write(json.dumps(response) + "\nMEMCASTLE_HTTP_STATUS:200")
